-- ServerScriptService/LobbyLeaderstats.server.lua (LOBBY PLACE)
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HighestRoundStore = DataStoreService:GetDataStore("HighestRound_v1")

Players.PlayerAdded:Connect(function(plr)
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = plr

	local round = Instance.new("IntValue"); round.Name = "Round"; round.Parent = ls
	round.Value = 0

	local highest = Instance.new("IntValue"); highest.Name = "HighestRound"; highest.Parent = ls
	local ok, saved = pcall(function() return HighestRoundStore:GetAsync(plr.UserId) end)
	highest.Value = (ok and tonumber(saved)) or 0
end)
